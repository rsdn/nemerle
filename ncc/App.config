<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Suppress the Win32 Abort/Retry/Ignore dialog of .NET Framework Debug.Assert:
       the assertion text goes to the trace listeners/stderr and the process fails
       immediately instead of blocking on a modal dialog (keeps non-interactive
       builds and CI usable). To get the dialog back while debugging, set
       assertuienabled="true" here or in the built ncc.exe.config. -->
  <system.diagnostics>
    <assert assertuienabled="false" />
  </system.diagnostics>
</configuration>
