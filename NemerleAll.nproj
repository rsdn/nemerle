<Project DefaultTargets="DevBuild2Stage" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <UsingTask TaskName="MSBuild.Community.Tasks.FileUpdate" AssemblyFile="$(MSBuildProjectDirectory)\ExternalDependences\MSBuild.Community.Tasks.dll" />
  <PropertyGroup>
    <UseMSBuild Condition="Exists('$(MSBuildBinPath)\msbuild.exe') or Exists('$(MSBuildBinPath)\msbuild.dll')">1</UseMSBuild>
    <ExeRunner Condition=" '$(OS)' == 'Windows_NT' "></ExeRunner>
    <ExeRunner Condition=" '$(OS)' != 'Windows_NT' ">mono </ExeRunner>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(NTargetName)' == '' ">
    <NTargetName Condition="'$(UseMSBuild)' != ''">Rebuild</NTargetName>
    <NTargetName Condition="'$(UseMSBuild)' == ''">Build</NTargetName>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(NInstall)' == '' ">
    <!--Folder for Nemerle installation. To install use "Install" target.-->
    <NInstall>$(ProgramFiles)\Nemerle\Net-4.0</NInstall>
  </PropertyGroup>
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <!--Suppress NETSDK1138 'target framework is out of support' warnings for EOL target frameworks.-->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!--Path to root directory of Nemerle sources.-->
    <NRoot>$(MSBuildProjectDirectory)</NRoot>
    <NPrefix Condition="'$(UseMSBuild)' != ''">net</NPrefix>
    <NPrefix Condition="'$(UseMSBuild)' == ''">mono</NPrefix>
    <NVer>$(NPrefix)-4.0</NVer>
    <!-- Original boot. Since 4.3: net10 framework-dependent seed (ncc).
        The boot-dnlib emergency fallback was retired in 7.4 (00cee342b);
        its content lives on in git history.-->
    <NRootBoot>$(NRoot)\boot</NRootBoot>
    <!--Path to stages output directory (including current configuration subfolder).-->
    <NBin>$(NRoot)\bin\$(Configuration)\$(NVer)</NBin>
    <NObj>$(NRoot)\obj\$(Configuration)\$(NVer)</NObj>
    <!--Path to boot compiler.-->
    <NBoot>$(NBin)\boot\</NBoot>
    <!-- Project Constants -->
    <NInstallIntegration Condition=" '$(NInstallIntegration)' == '' ">False</NInstallIntegration>
    <!-- Phase 5.5: the VS-IDE layer under snippets/VS2010 (WpfHint WPF popup,
         VSSDK-era Nemerle.VsExtension, Nemerle.Compiler.Utils) and the WiX MSI
         packaging are Windows-only and unmigrated to the net10 toolchain; the
         Core build+test graph (Stage*/Validate/CompilerTests/Install) never
         reaches them. _Integration/_Installer refuse to run unless the caller
         opts in with -p:BuildingVsIntegration=true on a Windows host; the
         shipping IDE integration lives on the `master` branch. -->
    <BuildingVsIntegration Condition=" '$(BuildingVsIntegration)' == '' ">false</BuildingVsIntegration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseMSBuild)' != ''">
    <NProjectConstants>NET_4_0</NProjectConstants>
    <NProjectConstants Condition="'$(Configuration)' == 'Debug'">$(NProjectConstants);DEBUG</NProjectConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseMSBuild)' == ''">
    <NProjectConstants>NET_4_0=1</NProjectConstants>
    <NProjectConstants Condition="'$(Configuration)' == 'Debug'">$(NProjectConstants);DEBUG=1</NProjectConstants>    
  </PropertyGroup>
  <PropertyGroup>
    <NDefineProjectConstants>DefineConstants=$(NProjectConstants)</NDefineProjectConstants>
  </PropertyGroup>
  <!--Project required to build any Nemerle project (.nproj)-->
  <ItemGroup Condition="'$(UseMSBuild)' != ''">
    <NTasksProject Include="$(NRoot)\Nemerle.MSBuild.Tasks.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseMSBuild)' == ''">
    <NTasksProject Include="$(NRoot)\Nemerle.XBuild.Tasks.csproj" />
  </ItemGroup>
  <ItemGroup>
    <CSharpCompilerFiles Include ="$(NBin)\PowerPack\CSharpParser.dll;$(NBin)\PowerPack\ncc.parser.csharp.dll;$(NBin)\PowerPack\Nemerle.Peg.dll"/>
  </ItemGroup>
  <!--Projects related only to compiler.-->
  <ItemGroup>
    <NCompilerProject Include="$(NRoot)\Nemerle.nproj" />
    <NCompilerProject Include="$(NRoot)\Nemerle.Compiler.nproj" />
    <NCompilerProject Include="$(NRoot)\Nemerle.Macros.nproj" />
    <!-- 3.4b: the legacy net461 ncc.nproj (FX ncc.exe) was removed from the stage
         graph; Phase 7.1 deleted it, ncc32/ncc64.nproj and ncc\App.config from
         disk (the shipping FX host lives on `master`). The net10 host project —
         it carried a hyphenated intermediate name through phases 3.4–10.0 — was
         renamed back to ncc.nproj in plan 10.1 and is the only compiler host
         now. -->
    <NCompilerProject Include="$(NRoot)\ncc.nproj" />
  </ItemGroup>

  <!-- Compiler test projects and Nemerle.Diff -->
  <ItemGroup>
    <NTestFramework Include="$(NRoot)\snippets\Nemerle.Test\Nemerle.Test.Framework\Nemerle.Test.Framework.nproj" />
    <NTestFramework Include="$(NRoot)\snippets\Nemerle.Test\Nemerle.Compiler.Test\Nemerle.Compiler.Test.nproj" />
    <NTestFramework Include="$(NRoot)\snippets\Nemerle.Diff\Nemerle.Diff\Nemerle.Diff.nproj" />
    <NTestFramework Include="$(NRoot)\snippets\Nemerle.Diff\Nemerle.Diff.Tests\Nemerle.Diff.Tests.nproj" />
  </ItemGroup>
  
  <!--Projects related to Nemerle.Peg-->
  <ItemGroup>
    <NPeg Include="$(NRoot)\snippets\peg-parser\Nemerle.Peg\Nemerle.Peg.nproj" />
    <NPeg Include="$(NRoot)\snippets\peg-parser\Nemerle.Peg.Macros\Nemerle.Peg.Macros.nproj" />
  </ItemGroup>

  <!--Projects related to C# parser-->
  <ItemGroup>
    <NCSharp Include="$(NRoot)\snippets\csharp-parser\CSharpParser\CSharpParser.nproj" />
    <NCSharp Include="$(NRoot)\snippets\csharp-parser\CSharpToNemerle\CSharpToNemerle.nproj" />
    <NCSharp Include="$(NRoot)\snippets\csharp-parser\CSharpParser.TestMacros\CSharpParser.TestMacros.nproj" />
    <NCSharp Include="$(NRoot)\snippets\csharp-parser\CSharpParser.Tests\CSharpParser.Tests.nproj" />
  </ItemGroup>

  <!--Projects related to ComputationExpressions -->
  <ItemGroup>
    <NComputationExpressions Include="$(NRoot)\snippets\ComputationExpressions\ComputationExpressions\ComputationExpressions.nproj" />
    <NComputationExpressions Include="$(NRoot)\snippets\ComputationExpressions\ComputationExpressions.Macros\ComputationExpressions.Macros.nproj" />
    <NComputationExpressions Include="$(NRoot)\snippets\ComputationExpressions\Test\Test.nproj" />
  </ItemGroup>

  <!--Projects related to Nemerle.Async -->
  <ItemGroup>
    <NAsync Include="$(NRoot)\snippets\Nemerle.Async\Nemerle.Async\Nemerle.Async.nproj" />
    <NAsync Include="$(NRoot)\snippets\Nemerle.Async\Nemerle.Async.Macros\Nemerle.Async.Macros.nproj" />
  </ItemGroup>
  
  <ItemGroup>
    <NStatechart Include="$(NRoot)\snippets\Nemerle.Statechart\Nemerle.Statechart_snippets.nproj" />
    <NStatechart Include="$(NRoot)\snippets\Nemerle.Statechart\Lib\Nemerle.Statechart.Lib.nproj" />
    <NStatechart Include="$(NRoot)\snippets\Nemerle.Statechart\Nemerle.Statechart.Runtime\Nemerle.Statechart.Runtime.nproj" />
    <NStatechart Include="$(NRoot)\snippets\Nemerle.Statechart\Tests\fsmtest\fsmtest_release.nproj" />
    <!--<NStatechart Include="$(NRoot)\snippets\Nemerle.Statechart\Tests\fsmtest\fsmtest.nproj" />
    <NStatechart Include="$(NRoot)\snippets\Nemerle.Statechart\Tests\gui_file_test\FileFsmTest.nproj" />-->
  </ItemGroup>

  <!--Projects related to PowerPack-->
  <ItemGroup>
    <NPowerPack Include="$(NRoot)\snippets\Nemerle.Xml\Nemerle.Xml.Macro\Nemerle.Xml.Macro.nproj" />
    <NPowerPack Include="$(NRoot)\snippets\ObjectExpressions\NewObjectMacro\NewObjectMacro.nproj" />
    <NPowerPack Include="$(NRoot)\snippets\Nemerle.Diff\Nemerle.Diff\Nemerle.Diff.nproj" />
    <NPowerPack Include="$(NRoot)\snippets\aop\DevMacros.nproj" />
    <NPowerPack Include="$(NRoot)\snippets\aop\Nemerle.Aop.nproj" />
    <NPowerPack Include="$(NRoot)\snippets\ActivePatterns\ActivePatterns\Nemerle.ActivePatterns.nproj" />
    <NPowerPack Include="$(NRoot)\snippets\Nemerle.VirtualStatics\Nemerle.VirtualStatics\Nemerle.VirtualStatics.nproj" />
  </ItemGroup>

  <!--Projects related to Linq-->
  <ItemGroup>
    <NLinq Include="$(NRoot)\Linq\Macro\Linq.nproj" />
  </ItemGroup>

  <ItemGroup>
    <NUnsafe Include="$(NRoot)\snippets\Nemerle.Unsafe\Nemerle.Unsafe\Nemerle.Unsafe.nproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseMSBuild)' != ''">
    <NWpf Include="$(NRoot)\snippets\Nemerle.WPF\Nemerle.WPF\Nemerle.WPF.nproj" />
  </ItemGroup>

  <ItemGroup>
    <CompilerTestsFiles Include="$(NBin)\Tests\**\*.*" />
  </ItemGroup>

  <!--Projects related to tools-->
  <ItemGroup>
    <NTools Include="$(NRoot)\tools\nemish.nproj" />
    <NTools Include="$(NRoot)\tools\Nemerle.Evaluation.nproj" />
    <NTools Include="$(NRoot)\tools\Nemerle.NAnt.Tasks.nproj" />
    <NTools Include="$(NRoot)\tools\reflector-addon\reflector-addon.nproj" />
  </ItemGroup>

  <!--Projects related to integration-->
  <ItemGroup Condition="'$(UseMSBuild)' != ''">
    <NIntegrationProject Include="$(NRoot)\snippets\VS2010\WpfHint\WpfHint.csproj" />
    <NIntegrationProject Include="$(NRoot)\snippets\VS2010\Nemerle.Compiler.Utils\Nemerle.Compiler.Utils.nproj" />
    <NIntegrationProject Include="$(NRoot)\snippets\VS2010\Nemerle.VsExtension\Nemerle.VsExtension.csproj" />
  </ItemGroup>

  <!--Initialize FX and SDK tools locations-->
  <Target Name="InitTools">
    <GetFrameworkSdkPath Condition="'$(UseMSBuild)' != ''">
      <Output TaskParameter="Path" PropertyName="SDK_3" />
    </GetFrameworkSdkPath>
    <GetFrameworkSdkPath Condition="'$(UseMSBuild)' == ''">
      <Output TaskParameter="Path" PropertyName="SDK" />
    </GetFrameworkSdkPath>
    <!-- Phase 5.1: only ildasm discovery is left here; gacutil/ngen/peverify and the al.exe-keyed probes were removed (the .NET Framework SDK tools are not used by the Core toolchain anymore). -->
    <PropertyGroup Condition="'$(UseMSBuild)' != ''">
      <SDKBin Condition="'$(SDKBin)' == '' And Exists('$(SDK_3)..\v10.0A\bin\NETFX 4.6.1 Tools\ildasm.exe')">$(SDK_3)..\v10.0A\bin\NETFX 4.6.1 Tools</SDKBin>
      <SDKBin Condition="'$(SDKBin)' == '' And Exists('$(SDK_3)..\v10.0A\bin\NETFX 4.6 Tools\ildasm.exe')"  >$(SDK_3)..\v10.0A\bin\NETFX 4.6 Tools</SDKBin>
      <SDKBin Condition="'$(SDKBin)' == '' And Exists('$(SDK_3)..\v8.1A\bin\NETFX 4.5.1 Tools\ildasm.exe')" >$(SDK_3)..\v8.1A\bin\NETFX 4.5.1 Tools</SDKBin>
      <SDKBin Condition="'$(SDKBin)' == '' And Exists('$(SDK_3)..\v8.1A\bin\NETFX 4.5 Tools\ildasm.exe')"   >$(SDK_3)..\v8.1A\bin\NETFX 4.5 Tools</SDKBin>
      <SDKBin Condition="'$(SDKBin)' == '' And Exists('$(SDK_3)..\v8.0\bin\NETFX 4.5 Tools\ildasm.exe')"    >$(SDK_3)..\v8.0\bin\NETFX 4.5 Tools</SDKBin>
      <SDKBin Condition="'$(SDKBin)' == '' And Exists('$(SDK_3)..\v8.0A\bin\NETFX 4.0 Tools\ildasm.exe')"   >$(SDK_3)..\v8.0A\bin\NETFX 4.0 Tools</SDKBin>
      <SDKBin Condition="'$(SDKBin)' == ''">$(SDK_3)\bin\NETFX 4.0 Tools</SDKBin>
      <!-- Retire this ildasm discovery together with the Validate `fc` step when Validate is eventually replaced by net10 tooling (the old "Phase 6.3" forward-reference shipped without doing it; corrected in 8.3b). Quirk (3.2 finding): ildasm /NOIL partial disassembly does not work for these assemblies; the full-dump mode used by Validate does. -->
      <Ildasm>"$(SDKBin)\ildasm.exe"</Ildasm>
      <MSBuild>$(MSBuildBinPath)\msbuild.exe</MSBuild>
      <Junction>$(NRoot)\ExternalDependences\junction.exe</Junction>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UseMSBuild)' == ''">
      <SDKToolsBin>$(SDK)\..\..\..\bin</SDKToolsBin>
      <Ildasm>"$(SDKToolsBin)\monodis"</Ildasm>
      <XBuild>$(MSBuildBinPath)\..\..\..\xbuild</XBuild>
      <Junction>$(NRoot)\ExternalDependences\junction.exe</Junction>
    </PropertyGroup>
    <Message Text="Framework tools found at:"    Importance="high" />
    <Message Text="     MSBuild  - $(MSBuild)"   Importance="high" Condition="'$(UseMSBuild)' != ''" />
    <Message Text="     XBuild   - $(XBuild)"    Importance="high" Condition="'$(UseMSBuild)' == ''" />
    <Message Text="  SDK tools found at:"        Importance="high" />
    <Message Text="     Ildasm   - $(Ildasm)"    Importance="high" />
    <Message Text="  ExternalDependences:"       Importance="high" />
    <Message Text="     Junction - $(Junction)"  Importance="high" />
  </Target>
  <!--Builds and deploy tasks dll into boot directory-->
  <Target Name="NTasks" DependsOnTargets="InitTools">
    <!-- 7.4: restore before building the tasks project, same pattern as Stage1
         below. Nemerle.MSBuild.Tasks.csproj has PackageReferences and classic
         MSBuild.exe does no implicit restore; on a clean clone (no obj\) the
         build died with NETSDK1004 before any BeforeTargets hook could run.
         `_dummy` per the msbuild#2811 workaround used by every stage below:
         without distinct global properties the build request reuses the
         pre-restore cached evaluation (no nuget.g.props imports -> CS0012).
         The XBuild variant has no PackageReferences; its Restore is a no-op. -->
    <MSBuild Projects="@(NTasksProject)" Properties="OutputPath=$(NBoot); IntermediateOutputPath=$(NObj)\Tasks\; NKeysDir=$(NBin)\keys; _dummy=1" Targets="Restore" />
    <MSBuild Projects="@(NTasksProject)" Properties="OutputPath=$(NBoot); IntermediateOutputPath=$(NObj)\Tasks\; NKeysDir=$(NBin)\keys; _dummy=2" Targets="$(NTargetName)" />
    <CreateItem Include="$(NBoot)\Nemerle.MSBuild.Tasks.dll" Condition="'$(UseMSBuild)' != ''">
      <Output ItemName="NTasksFiles" TaskParameter="Include" />
    </CreateItem>
    <CreateItem Include="$(NBoot)\Nemerle.XBuild.Tasks.dll" Condition="'$(UseMSBuild)' == ''">
      <Output ItemName="NTasksFiles" TaskParameter="Include" />
    </CreateItem>
    <CreateItem Include="$(NBoot)\Nemerle.MSBuild.targets">
      <Output ItemName="NTasksFiles" TaskParameter="Include" />
    </CreateItem>
    <CreateItem Include="$(NBoot)\Nemerle.Sdk.props">
      <Output ItemName="NTasksFiles" TaskParameter="Include" />
    </CreateItem>
    <CreateItem Include="$(NBoot)\Nemerle.Sdk.targets">
      <Output ItemName="NTasksFiles" TaskParameter="Include" />
    </CreateItem>
    <CreateItem Include="$(NBoot)\ncc.bat" Condition="'$(UseMSBuild)' == ''">
      <Output ItemName="NTasksFiles" TaskParameter="Include" />
    </CreateItem>
    <CreateItem Include="$(NBoot)\ncc" Condition="'$(UseMSBuild)' == ''">
      <Output ItemName="NTasksFiles" TaskParameter="Include" />
    </CreateItem>
  </Target>
  <!--Boot files-->
  <Target Name="NPrepareBoot">
    <CreateItem  Include="$(NRootBoot)\*.exe">
      <Output ItemName="NBootFiles" TaskParameter="Include" />
    </CreateItem>
    <CreateItem Include="$(NRootBoot)\*.dll">
      <Output ItemName="NBootFiles" TaskParameter="Include" />
    </CreateItem>
    <!--Seed sidecar configs (a boot-dnlib-era idiom, e.g. its ncc.exe.config):
        keep Debug.Assert failures non-interactive (no modal Abort/Retry/Ignore
        dialog). Source of the FX one, ncc\App.config, was deleted with
        ncc.nproj in Phase 7.1; the glob stays for seeds shipping .config
        files (the current net10 seed ships none).-->
    <CreateItem Include="$(NRootBoot)\*.config">
      <Output ItemName="NBootFiles" TaskParameter="Include" />
    </CreateItem>
    <!--ncc.runtimeconfig.json/ncc.deps.json: required by the .NET
        apphost next to ncc.dll (net10 seed, 4.2; boot/ since 10.2). Kept as a glob:
        seeds that carry no *.json (the retired boot-dnlib) stay harmless.-->
    <CreateItem Include="$(NRootBoot)\*.json">
      <Output ItemName="NBootFiles" TaskParameter="Include" />
    </CreateItem>
    <Copy SourceFiles="@(NBootFiles)" DestinationFolder="$(NBoot)" />
  </Target>
  <!--Keys-->
  <Target Name="NPrepareKeys">
    <CreateItem Include="$(NRoot)\misc\keys\*.snk">
      <Output ItemName="NKeyFiles" TaskParameter="Include"/>
    </CreateItem>
    <Copy SourceFiles="@(NKeyFiles)" DestinationFolder="$(NBin)\keys" />
  </Target>
  <!--Builds compiler using boot-->
  <Target Name="Stage1" DependsOnTargets="NPrepareKeys;NPrepareBoot;NTasks">
    <PropertyGroup>
      <NPrevBin>$(NBoot)</NPrevBin>
      <NCurBin>$(NBin)\Stage1</NCurBin>
      <NCurObj>$(NObj)\Stage1</NCurObj>
    </PropertyGroup>
    <Message Importance="high" Text="SDKBin='$(SDKBin)'" />
    <Message Importance="high" Text="SDK_3='$(SDK_3)'" />
    <!-- _dummy value is required due to MSBuild issue: https://github.com/microsoft/msbuild/issues/2811 -->
    <MSBuild Projects="@(NCompilerProject)" Properties="OutputPath=$(NCurBin); IntermediateOutputPath=$(NCurObj)\; Nemerle=$(NPrevBin); NKeysDir=$(NBin)\keys; SDKBin=$(SDKBin); _dummy=1" Targets="Restore" />
    <ItemGroup>
      <ProjectAssetsJsonFile Include="$(NCurObj)\**\project.assets.json" />
      <ProjectAssetsFile Include="$([System.IO.Path]::GetDirectoryName('%(ProjectAssetsJsonFile.Identity)'))\*.*">
        <SubDirectoryName>$([System.IO.Path]::GetFileName('$([System.IO.Path]::GetDirectoryName('%(ProjectAssetsJsonFile.Identity)'))'))</SubDirectoryName>
      </ProjectAssetsFile>
    </ItemGroup>
    <MSBuild Projects="@(NCompilerProject)" Properties="OutputPath=$(NCurBin); IntermediateOutputPath=$(NCurObj)\; Nemerle=$(NPrevBin); NKeysDir=$(NBin)\keys; SDKBin=$(SDKBin); _dummy=2" Targets="$(NTargetName)" />
    <Copy SourceFiles="@(NTasksFiles)" DestinationFolder="$(NCurBin)" />
  </Target>
  <!--Builds compiler using Stage1-->
  <Target Name="Stage2" DependsOnTargets="Stage1">
    <PropertyGroup>
      <NPrevBin>$(NBin)\Stage1</NPrevBin>
      <NCurBin>$(NBin)\Stage2</NCurBin>
      <NCurObj>$(NObj)\Stage2</NCurObj>
    </PropertyGroup>
    <Copy SourceFiles="@(ProjectAssetsFile)" DestinationFolder="$(NCurObj)\%(ProjectAssetsFile.SubDirectoryName)" />
    <MSBuild Projects="@(NCompilerProject)" Properties="OutputPath=$(NCurBin); IntermediateOutputPath=$(NCurObj)\; Nemerle=$(NPrevBin); NKeysDir=$(NBin)\keys; SDKBin=$(SDKBin)" Targets="$(NTargetName)" />
    <Copy SourceFiles="@(NTasksFiles)" DestinationFolder="$(NCurBin)" />
  </Target>
  <!--Builds compiler using Stage2-->
  <Target Name="Stage3" DependsOnTargets="Stage2">
    <PropertyGroup>
      <NPrevBin>$(NBin)\Stage2</NPrevBin>
      <NCurBin>$(NBin)\Stage3</NCurBin>
      <NCurObj>$(NObj)\Stage3</NCurObj>
    </PropertyGroup>
    <Copy SourceFiles="@(ProjectAssetsFile)" DestinationFolder="$(NCurObj)\%(ProjectAssetsFile.SubDirectoryName)" />
    <MSBuild Projects="@(NCompilerProject)" Properties="OutputPath=$(NCurBin); IntermediateOutputPath=$(NCurObj)\; Nemerle=$(NPrevBin); NKeysDir=$(NBin)\keys; SDKBin=$(SDKBin)" Targets="$(NTargetName)" />
    <Copy SourceFiles="@(NTasksFiles)" DestinationFolder="$(NCurBin)" />
  </Target>
  <!--Builds compiler using Stage3-->
  <Target Name="Stage4" DependsOnTargets="Stage3">
    <PropertyGroup>
      <NPrevBin>$(NBin)\Stage3</NPrevBin>
      <NCurBin>$(NBin)\Stage4</NCurBin>
      <NCurObj>$(NObj)\Stage4</NCurObj>
    </PropertyGroup>
    <Copy SourceFiles="@(ProjectAssetsFile)" DestinationFolder="$(NCurObj)\%(ProjectAssetsFile.SubDirectoryName)" />
    <MSBuild Projects="@(NCompilerProject)" Properties="OutputPath=$(NCurBin); IntermediateOutputPath=$(NCurObj)\; Nemerle=$(NPrevBin); NKeysDir=$(NBin)\keys; SDKBin=$(SDKBin)" Targets="$(NTargetName)" />
    <Copy SourceFiles="@(NTasksFiles)" DestinationFolder="$(NCurBin)" />
  </Target>

  <!--Builds only PowerPack using Stage1 compiler.-->
  <Target Name="PowerPack" DependsOnTargets="Stage1; _PowerPack" />

  <!--Builds all tools, linq, vs integration and shell. Only Stage1 compiler required.-->
  <Target Name="IntegrationFast" DependsOnTargets="Stage1; _Integration" />

  <!--Builds all tools, linq, vs integration and shell. Stage4 compiler required.-->
  <Target Name="IntegrationFull" DependsOnTargets="Stage4; Validate; CompilerTests; _Integration; IdeEngineTests" />

  <!--Builds MSI package. Only Stage1 compiler required.-->
  <Target Name="InstallerFast" DependsOnTargets="IntegrationFast; _PowerPack; _NugetPack; _Installer;" />

  <!--Builds MSI package. Stage4 compiler required.-->
  <Target Name="InstallerFull" DependsOnTargets="IntegrationFull; _PowerPack; _NugetPack; _Installer;"  />

  <!--Compare last two stages on IL level-->
  <Target Name="Validate" DependsOnTargets="InitTools">
    <Delete Files="$(NPrevBin)\*.il;$(NCurBin)\*.il" />
    <ItemGroup>
      <!-- Managed assemblies only. Since 10.1 the host is ncc.exe: a native
           apphost (no CLR metadata), so no `ncc*.exe` Asm include (the pre-10.1
           one matched nothing and was guarded by Exclude="ncc-*.exe"); its
           managed payload ncc.dll joins the Il* sets below. -->
      <Asm2 Include="$(NPrevBin)\Nemerle*.dll" />
      <Asm3 Include="$(NCurBin)\Nemerle*.dll" />
      <!-- IL comparison additionally covers the managed Core payload: -->
      <Il2 Include="@(Asm2)" />
      <Il2 Include="$(NPrevBin)\ncc.dll" />
      <Il3 Include="@(Asm3)" />
      <Il3 Include="$(NCurBin)\ncc.dll" />
    </ItemGroup>
    <PropertyGroup Condition="'$(UseMSBuild)' != ''" >
      <ValidateOutParameter>/out</ValidateOutParameter>
      <ValidateAdditionalParameters>/nobar</ValidateAdditionalParameters>
    </PropertyGroup>
    <PropertyGroup Condition="'$(UseMSBuild)' == ''" >
      <ValidateOutParameter>--output</ValidateOutParameter>
      <ValidateAdditionalParameters></ValidateAdditionalParameters>
    </PropertyGroup>
    <Exec Command="$(Ildasm) &quot;%(Il2.FullPath)&quot; $(ValidateOutParameter)=&quot;%(Il2.FullPath).il&quot; $(ValidateAdditionalParameters)" WorkingDirectory="$(NPrevBin)" />
    <Exec Command="$(Ildasm) &quot;%(Il3.FullPath)&quot; $(ValidateOutParameter)=&quot;%(Il3.FullPath).il&quot; $(ValidateAdditionalParameters)" WorkingDirectory="$(NCurBin)" />
    <ItemGroup>
      <IL_PREV Include="$(NPrevBin)\*.il" />
      <IL_LAST Include="$(NCurBin)\*.il" />
    </ItemGroup>
    <MSBuild.Community.Tasks.FileUpdate Files="@(IL_PREV)" Regex="^(//.*)(?=\r)" ReplacementText="// REPLACED" Multiline="True" />
    <MSBuild.Community.Tasks.FileUpdate Files="@(IL_LAST)" Regex="^(//.*)(?=\r)" ReplacementText="// REPLACED" Multiline="True" />
    
    <!-- Windows -->
    <MSBuild.Community.Tasks.FileUpdate Files="@(IL_PREV)" Regex="^(//.*)(?=\r)" ReplacementText="// REPLACED" Multiline="True" Condition=" '$(OS)' == 'Windows_NT' "/>
    <MSBuild.Community.Tasks.FileUpdate Files="@(IL_LAST)" Regex="^(//.*)(?=\r)" ReplacementText="// REPLACED" Multiline="True" Condition=" '$(OS)' == 'Windows_NT' "/>
    <!-- Coverage note (review #1 R1-05 / atom 8.3c): of the 5 compared IL
         dumps, Nemerle.MSBuild.Tasks.dll is a tautological match: NTasks
         builds it once into $(NBoot) and each stage only Copies the same
         @(NTasksFiles), so both stage dirs hold byte-identical copies of the
         boot-built task dll. Real self-compiled IL coverage is the other 4
         (Nemerle, Nemerle.Compiler, Nemerle.Macros, ncc). The
         comparison is kept as a harmless tripwire against a divergent
         copy step.
         Direction note (R1-05, confirmed by review #2 fc experiment):
         `fc "<p1>\*.il" "<p2>\*.il"` iterates only the FIRST wildcard; a
         dump present only under <p2> is silently skipped (exit 0), while
         a first-set-only dump fails "FC: cannot open" (exit 2). Hence the
         comparison runs in both directions below, so a Stage3-only
         unexpected dump is caught by the reversed run. Each direction
         prints one "FC: no differences" line per assembly (CI gate: 10). -->
    <Exec Command="fc &quot;$(NPrevBin)\*.il&quot; &quot;$(NCurBin)\*.il&quot;" Condition=" '$(OS)' == 'Windows_NT' "/>
    <Exec Command="fc &quot;$(NCurBin)\*.il&quot; &quot;$(NPrevBin)\*.il&quot;" Condition=" '$(OS)' == 'Windows_NT' "/>
    <!-- Unix -->
    <MSBuild.Community.Tasks.FileUpdate Files="@(IL_PREV)" Regex="//.*$" ReplacementText="// REPLACED" Multiline="True" Condition=" '$(OS)' != 'Windows_NT' "/>
    <MSBuild.Community.Tasks.FileUpdate Files="@(IL_LAST)" Regex="//.*$" ReplacementText="// REPLACED" Multiline="True" Condition=" '$(OS)' != 'Windows_NT' "/>
    <Exec Command="for il in $(NPrevBin)/*.il; do diff $il &quot;$(NCurBin)/${il##*/}&quot; || exit 1; done" Condition=" '$(OS)' != 'Windows_NT' " />

    <Delete Files="@(IL_PREV)" />
    <Delete Files="@(IL_LAST)" />
  </Target>

  <!--Runs compiler tests.-->
  <Target Name="CompilerTests" DependsOnTargets="Linq;Unsafe;_PegAndCSharp;TestFramework;_Wpf">
    <PropertyGroup>
      <NTeamCityPositiveTestArguments Condition=" '$(TEAMCITY_VERSION)' != '' ">"-team-city-test-suite:Ncc-Positive-$(NVer)"</NTeamCityPositiveTestArguments>
      <NTeamCityNegativeTestArguments Condition=" '$(TEAMCITY_VERSION)' != '' ">"-team-city-test-suite:Ncc-Negative-$(NVer)"</NTeamCityNegativeTestArguments>
      <!-- Phase 6.3: optional allowlist of tests known to fail (net10 plan
           6.4 owns the 8 listed ones). Set the NKnownFailures property (or
           the same-named environment variable, MSBuild exposes env vars as
           properties) to a path the harness can read. CompilerTests
           copies testsuite\*.* (including the shipped ci-known-failures-64.txt)
           into both test working directories, so a bare file name works (no
           spaces => passed space-separated and unquoted, the proven `-r
           dotnet' pattern: getopt takes the following token as the value;
           embedding quotes here would make the .NET-Core-MSBuild Exec glue
           into ONE argument (verified failure in 6.3). Unset => the argument
           is not passed and the harness runs unfiltered: any failure fails
           the build (default-off). -->
      <NKnownFailuresArg Condition=" '$(NKnownFailures)' != '' ">-known-failures $(NKnownFailures)</NKnownFailuresArg>
    </PropertyGroup>
    <CreateItem Include="$(NBin)\TestFramework\*.*">
      <Output ItemName="NTestFrameworkFiles" TaskParameter="Include" />
    </CreateItem>
    <!--Delete Files="@(CompilerTestsFiles)" /  DONT WORK WITH READONLY FILES!-->
    <Exec Command="IF EXIST &quot;$(NBin)\Tests\&quot; DEL &quot;$(NBin)\Tests\&quot; /F /S /Q" WorkingDirectory="$(NBin)\" Condition=" '$(OS)' == 'Windows_NT' " />
    <Delete Files="@(CompilerTestsFiles)" Condition=" '$(OS)' != 'Windows_NT' " />	
    <Copy SourceFiles="$(NBin)\Linq\Nemerle.Linq.dll;$(NBin)\Unsafe\Nemerle.Unsafe.dll;@(CSharpCompilerFiles)" DestinationFolder="$(NBin)\Tests\positive" />
    <Copy SourceFiles="$(NBin)\Linq\Nemerle.Linq.dll;$(NBin)\Unsafe\Nemerle.Unsafe.dll;@(CSharpCompilerFiles)" DestinationFolder="$(NBin)\Tests\negative" />	
    <Copy SourceFiles="$(NBin)\PowerPack\Nemerle.WPF.dll" DestinationFolder="$(NBin)\Tests\positive" Condition=" '$(UseMSBuild)' != '' " />
    <Copy SourceFiles="$(NBin)\PowerPack\Nemerle.WPF.dll" DestinationFolder="$(NBin)\Tests\negative" Condition=" '$(UseMSBuild)' != '' " />	
    <!--Delete all temporary files in old testing directory-->
    <CreateItem Include="$(NRoot)\testsuite\*.exe;$(NRoot)\testsuite\*.dll;$(NRoot)\testsuite\*.pdb">
      <Output ItemName="NTestSuiteTempFiles" TaskParameter="Include"/>
    </CreateItem>
    <Delete Files="@(NTestSuiteTempFiles)" />
    <!--Copy test files to the testing directory-->
    <CreateItem Include="$(NRoot)\testsuite\*.*">
      <Output ItemName="NTestSuiteFiles" TaskParameter="Include" />
    </CreateItem>
    <Copy SourceFiles="@(NTestFrameworkFiles);@(NTestSuiteFiles)" DestinationFolder="$(NBin)\Tests\positive" />
    <Copy SourceFiles="@(NTestFrameworkFiles);@(NTestSuiteFiles)" DestinationFolder="$(NBin)\Tests\negative" />
    <!--Phase 6.2c (report 6.2a Q2): -r dotnet -rp exec makes the harness launch
        BEGIN-OUTPUT run exes via `dotnet exec <test>.exe` (hostfxr) instead of
        Process.Start'ing the bare managed PE, which Windows runs on the FX
        mscoree shim (exit 0xE0434352). `dotnet` resolves from PATH; `exec` is
        the hostfxr subcommand, not a path. The matching <test>.runtimeconfig.json
        is written by NccTest.compile (Core-host-gated). FX-legacy Execs elsewhere
        keep the direct launch.-->
    <!--Run positive tests-->
    <Exec Command="$(ExeRunner)&quot;$(NBin)\Tests\positive\Nemerle.Compiler.Test.exe&quot; $(NTeamCityPositiveTestArguments) $(NKnownFailuresArg) -r dotnet -rp exec -output:. &quot;-p:-nowarn:10003 -def:$(NProjectConstants)&quot; &quot;$(NRoot)\testsuite\positive\*.n&quot; &quot;$(NRoot)\testsuite\positive\*.nnn&quot; &quot;$(NRoot)\testsuite\positive\*.cs&quot;" WorkingDirectory="$(NBin)\Tests\positive" IgnoreStandardErrorWarningFormat="true" />
    <!--Run negative tests-->
    <Exec Command="$(ExeRunner)&quot;$(NBin)\Tests\negative\Nemerle.Compiler.Test.exe&quot; $(NTeamCityNegativeTestArguments) $(NKnownFailuresArg) -r dotnet -rp exec -output:. &quot;-p:-nowarn:10003 -def:$(NProjectConstants)&quot; &quot;$(NRoot)\testsuite\negative\*.n&quot; &quot;$(NRoot)\testsuite\negative\*.nnn&quot; &quot;$(NRoot)\testsuite\negative\*.cs&quot;" WorkingDirectory="$(NBin)\Tests\negative" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <!--Install Nemerle compiler to specified folder. By default to ProgramFiles. To override folder set NInstall property.-->
  <Target Name="Install" DependsOnTargets="InitTools" Condition="'$(UseMSBuild)' != ''">
    <Error Condition=" '$(NCurBin)' == '' " Text="Property NCurBin is not set. Any stage of compilation should preceed the Install target." />
    <!--Path which should contane binary filese to be installed-->
    <!--PropertyGroup Condition=" '$(NCurBin)' == '' ">
      <NCurBin>$(NBin)\Stage1</NCurBin>
    </PropertyGroup-->
    <Message Importance="high" Text="Install binaries from: '$(NCurBin)'" />
    <ItemGroup>
      <_FilesToCopyToNInstallExculde Include="Nemerle.dll" />
      <_FilesToCopyToNInstallExculde Include="Nemerle.pdb" />
      <_FilesToCopyToNInstallExculde Include="Nemerle.xml" />
      <_FilesToCopyToNInstallExculde Include="Nemerle.Compiler.dll" />
      <_FilesToCopyToNInstallExculde Include="Nemerle.Compiler.pdb" />
      <_FilesToCopyToNInstallExculde Include="Nemerle.Compiler.xml" />
      <_FilesToCopyToNInstallExculde Include="Nemerle.Macros.dll" />
      <_FilesToCopyToNInstallExculde Include="Nemerle.Macros.pdb" />
      <_FilesToCopyToNInstallExculde Include="Nemerle.Macros.xml" />

      <FilesToCopyToNInstall Include="$(NBin)\Linq\*.*" Exclude="@(_FilesToCopyToNInstallExculde->'$(NBin)\Linq\%(Filename)%(Extension)')" />
      <FilesToCopyToNInstall Include="$(NBin)\Unsafe\*.*" Exclude="@(_FilesToCopyToNInstallExculde->'$(NBin)\Unsafe\%(Filename)%(Extension)')" />
      <FilesToCopyToNInstall Include="$(NBin)\TestFramework\*.*" Exclude="@(_FilesToCopyToNInstallExculde->'$(NBin)\TestFramework\%(Filename)%(Extension)')" />
      <FilesToCopyToNInstall Include="$(NBin)\PowerPack\*.*" Exclude="@(_FilesToCopyToNInstallExculde->'$(NBin)\PowerPack\%(Filename)%(Extension)')" />
      <FilesToCopyToNInstall Include="$(NBin)\Nuget\*.*" />
      <FilesToCopyToNInstall Include="$(NCurBin)\*.*" />
    </ItemGroup>

    <Copy SkipUnchangedFiles="true" SourceFiles="@(FilesToCopyToNInstall)" DestinationFolder="$(NInstall)" />
  </Target>

  <!-- Phase 5.5 guard: listed FIRST in the DependsOnTargets of _Integration and
       _Installer, so even a direct invocation stops with these messages before
       any snippets/VS2010 or WiX build is attempted. The Core build+test graph
       never runs this target. -->
  <Target Name="_GuardVsIntegration">
    <Error Condition="'$(OS)' != 'Windows_NT'" Text="The VS IDE/installer targets are Windows-only: snippets/VS2010 (VSSDK + WPF: WpfHint, Nemerle.VsExtension) and misc/packages/wix (WiX) cannot build on OS='$(OS)'. The Core compiler graph (Stage*/Validate/CompilerTests/Install) never reaches them; nothing there requires this target. (net10 plan 5.5)" />
    <Error Condition="'$(BuildingVsIntegration)' != 'true'" Text="_Integration/_Installer (VS IDE layer under snippets/VS2010 + MSI packaging) are opt-in since net10 plan 5.5: Windows-only and unmigrated to the net10 toolchain; the shipping IDE integration lives on the `master` branch. On a Windows host with the VS2017-era VSSDK prerequisites, re-run with -p:BuildingVsIntegration=true to attempt them anyway. (net10 plan 5.5)" />
  </Target>

  <!-- Helper target to build integration (Windows-only IDE layer; gated by
       _GuardVsIntegration since 5.5). -->
  <Target Name="_Integration" DependsOnTargets="_GuardVsIntegration; Linq; Unsafe; TestFramework" Condition="'$(UseMSBuild)' != ''">
    <PropertyGroup>
      <BuildProps>OutputPath=$(NBin)\VsIntegration\; Nemerle=$(NCurBin); Configuration=$(Configuration); BaseIntermediateOutputPath=$(NObj)\VsIntegration\; IntermediateOutputPath=$(NObj)\VsIntegration\; NKeysDir=$(NBin)\keys; DeployExtension=$(NInstallIntegration)</BuildProps>
    </PropertyGroup>
    <MSBuild Projects="@(NIntegrationProject)" Properties="$(BuildProps);_dummy=1" Targets="Restore" />
    <MSBuild Projects="@(NIntegrationProject)" Properties="$(BuildProps);_dummy=2" Targets="$(NTargetName)" />
  </Target>

  <Target Name="TestFramework">
    <PropertyGroup>
      <BuildProps>OutputPath=$(NBin)\TestFramework\; IntermediateOutputPath=$(NObj)\TestFramework\; Nemerle=$(NCurBin); $(NDefineProjectConstants); Configuration=$(Configuration); NKeysDir=$(NBin)\keys</BuildProps>
    </PropertyGroup>
    <MSBuild Projects="@(NTestFramework)" Properties="$(BuildProps);_dummy=1" Targets="Restore" />
    <MSBuild Projects="@(NTestFramework)" Properties="$(BuildProps);_dummy=2" Targets="$(NTargetName)" />
    <!-- run Nemerle.Diff tests -->
    <Exec Command="$(ExeRunner)&quot;$(NBin)\TestFramework\Nemerle.Diff.Tests.exe&quot;" />
  </Target>

  <Target Name="Linq">
    <PropertyGroup>
      <BuildProps>OutputPath=$(NBin)\Linq\; IntermediateOutputPath=$(NObj)\Linq\; Nemerle=$(NCurBin); $(NDefineProjectConstants); Configuration=$(Configuration); NKeysDir=$(NBin)\keys</BuildProps>
    </PropertyGroup>
    <MSBuild Projects="@(NLinq)" Properties="$(BuildProps);_dummy=1" Targets="Restore" />
    <MSBuild Projects="@(NLinq)" Properties="$(BuildProps);_dummy=2" Targets="$(NTargetName)" />
  </Target>

  <Target Name="Unsafe">
    <PropertyGroup>
      <BuildProps>OutputPath=$(NBin)\Unsafe\; IntermediateOutputPath=$(NObj)\Unsafe\; Nemerle=$(NCurBin); $(NDefineProjectConstants); Configuration=$(Configuration); NKeysDir=$(NBin)\keys</BuildProps>
    </PropertyGroup>
    <MSBuild Projects="@(NUnsafe)" Properties="$(BuildProps);_dummy=1" Targets="Restore" />
    <MSBuild Projects="@(NUnsafe)" Properties="$(BuildProps);_dummy=2" Targets="$(NTargetName)" />
  </Target>

  <Target Name="Tools">
    <MSBuild Projects="@(NTools)" Properties="OutputPath=$(NBin)\Tools\; IntermediateOutputPath=$(NObj)\Tools\; Nemerle=$(NCurBin); $(NDefineProjectConstants); Configuration=$(Configuration); NKeysDir=$(NBin)\keys" Targets="$(NTargetName)" />
  </Target>

  <!--Helper target to build PEG, C# parser, and test it -->
  <Target Name="_PegAndCSharp">
    <PropertyGroup>
      <BuildProps>OutputPath=$(NBin)\PowerPack\; IntermediateOutputPath=$(NObj)\PowerPack\; Nemerle=$(NCurBin); Configuration=$(Configuration); NKeysDir=$(NBin)\keys</BuildProps>
    </PropertyGroup>
    <MSBuild Projects="@(NPeg);@(NCSharp)" Properties="$(BuildProps);_dummy=1" Targets="Restore" />
    <MSBuild Projects="@(NPeg)"            Properties="$(BuildProps);_dummy=2" Targets="$(NTargetName)" />
    <MSBuild Projects="@(NCSharp)"         Properties="$(BuildProps);_dummy=2" Targets="$(NTargetName)" />
    <!-- run tests -->
    <Exec Command="$(ExeRunner)&quot;$(NBin)\PowerPack\CSharpParser.Tests.exe&quot;" />
  </Target>

  <!--Helper target to build ComputationExpressions and test it -->
  <Target Name="_ComputationExpressions">
    <PropertyGroup>
      <BuildProps>OutputPath=$(NBin)\PowerPack\; IntermediateOutputPath=$(NObj)\PowerPack\; Nemerle=$(NCurBin); Configuration=$(Configuration); NKeysDir=$(NBin)\keys</BuildProps>
    </PropertyGroup>
    <MSBuild Projects="@(NComputationExpressions)" Properties="$(BuildProps);_dummy=1" Targets="Restore" />
    <MSBuild Projects="@(NComputationExpressions)" Properties="$(BuildProps);_dummy=2" Targets="$(NTargetName)" />
    <!-- run tests -->
    <!--<Exec Command="$(ExeRunner)&quot;$(NBin)\PowerPack\ComputationExpressions.Tests.exe&quot;" />-->
  </Target>
  
  <!--Helper target to build Nemerle.Async and test it -->
  <Target Name="_Async">
    <PropertyGroup>
      <BuildProps>OutputPath=$(NBin)\PowerPack\; IntermediateOutputPath=$(NObj)\PowerPack\; Nemerle=$(NCurBin); Configuration=$(Configuration); NKeysDir=$(NBin)\keys</BuildProps>
    </PropertyGroup>
    <MSBuild Projects="@(NAsync)" Properties="$(BuildProps);_dummy=1" Targets="Restore" />
    <MSBuild Projects="@(NAsync)" Properties="$(BuildProps);_dummy=2" Targets="$(NTargetName)" />
  </Target>
  
  <!--Helper target to build Nemerle.Statechart and test it -->
  <Target Name="_Statechart" DependsOnTargets="_PegAndCSharp">
    <MSBuild Projects="@(NStatechart)" Properties="OutputPath=$(NBin)\PowerPack\; IntermediateOutputPath=$(NObj)\PowerPack\; Nemerle=$(NCurBin); NemerlePowerPack=$(NBin)\PowerPack; Configuration=$(Configuration); NKeysDir=$(NBin)\keys" Targets="$(NTargetName)" />    
    <!-- run tests -->
    <!-- <Exec Command="$(ExeRunner)&quot;$(NBin)\PowerPack\fsmtest.exe&quot;" /> -->
  </Target>

  <PropertyGroup>    
    <PowerPackDir>$(NBin)\PowerPack\</PowerPackDir>
    <NSTestSuiteDir>$(NRoot)\snippets\Nemerle.Statechart\tests\testsuite\</NSTestSuiteDir>
    <NSTestsDir>$(NSTestSuiteDir)\tests\</NSTestsDir>
  </PropertyGroup>
  
  <ItemGroup>
    <NStateChartTestFiles Include="$(PowerPackDir)\Nemerle.Statechart.Lib.dll" />
    <NStateChartTestFiles Include="$(PowerPackDir)\Nemerle.dll" />
    <NStateChartTestFiles Include="$(PowerPackDir)\Nemerle.Statechart.dll" />
    <NStateChartTestFiles Include="$(PowerPackDir)\Nemerle.Statechart.Runtime.dll" />
    <NStateChartTestFiles Include="$(PowerPackDir)\fsmtest.exe" />
    <NStateChartRefFiles Include="@(NStateChartTestFiles)" Exclude="$(PowerPackDir)\Nemerle.dll"/>
    <NStateChartRefs Include="@(NStateChartRefFiles->'$(NSTestsDir)\%(filename)%(extension)')" />    
  </ItemGroup>
  
  <Target Name="NStatechartTests" DependsOnTargets="Stage1;_Statechart">
    <ItemGroup>
      <NSTestsRefs Include="@(NStateChartRefs->'-ref:&quot;%(identity)&quot;')" />      
    </ItemGroup>
    
    <PropertyGroup>
      <NTest>$(NBin)\TestFramework\Nemerle.Compiler.Test.exe</NTest>
      <TestCommand>$(ExeRunner)$(NTest) @(NSTestsRefs, ' ') -output:tests\ positive\*.n negative\*.n</TestCommand>
    </PropertyGroup>

    <Delete Files="$(NSTestsDir)\*.*" />
    <Copy SourceFiles="@(NStateChartTestFiles)" DestinationFolder="$(NSTestsDir)" />

    <Exec Command="$(TestCommand)" WorkingDirectory="$(NSTestSuiteDir)" />
  </Target>
  
  <!--Helper target to build Nemerle.WPF, a netstandard2.0 test-suite
      fixture (Windows-only code removed since the net10 retarget: it was a
      v4.6.1 project referencing WindowsBase, MSB3644 on VS 18 BuildTools
      agents that ship no 4.6.1 targeting pack; now it follows the Linq.nproj
      Sdk shape and needs no FX packs, see the header comment in
      snippets\Nemerle.WPF\Nemerle.WPF\Nemerle.WPF.nproj). The two
      Nemerle.WPF.dll copies in CompilerTests used to be Windows_NT-only for
      the same reason; the conditions are gone with the FX dependency. The
      CompilerTests -> _Wpf edge itself is kept DELIBERATELY: Nemerle.WPF.dll
      is a test-suite fixture (testsuite\{positive,negative}\notifypropertychanged.n
      declare `MACRO: Nemerle.WPF.dll`, harness: NccTestDescription.n:61 then
      NccTest.n:184 passes it as -m:), not IDE code; dropping the edge would
      fail 2 of the 468+167 gate tests. Nemerle.WPF is not reachable from
      Stage*/Validate/Install. Sdk-style like every other restored project:
      Restore first, then build (no self-restore hook, see the csproj note in
      the NTasks area). -->
  <Target Name="_Wpf" Condition="'$(UseMSBuild)' != ''">
    <PropertyGroup>
      <BuildProps>OutputPath=$(NBin)\PowerPack\; IntermediateOutputPath=$(NObj)\PowerPack\; Nemerle=$(NCurBin); Configuration=$(Configuration); NKeysDir=$(NBin)\keys</BuildProps>
    </PropertyGroup>
    <MSBuild Projects="@(NWpf)" Properties="$(BuildProps);_dummy=1" Targets="Restore" />
    <MSBuild Projects="@(NWpf)" Properties="$(BuildProps);_dummy=2" Targets="$(NTargetName)" />
  </Target>

  <!--Helper target to build power pack-->
  <Target Name="_PowerPack" DependsOnTargets="_PegAndCSharp; Unsafe; TestFramework; _ComputationExpressions; _Async; _Statechart; _Wpf">
    <MSBuild Projects="@(NPowerPack)" Properties="OutputPath=$(NBin)\PowerPack\; IntermediateOutputPath=$(NObj)\PowerPack\; Nemerle=$(NCurBin); Configuration=$(Configuration); NKeysDir=$(NBin)\keys" Targets="$(NTargetName)" />
  </Target>
  
  <!-- Phase 6.5: nuspec packaging revived on modern tooling (5.4 removed
       ExternalDependences\NuGet.exe; 3.2 recorded the `ncc.???`/`lib\net\`
       nuspec defects, fixed with them). `dotnet pack` packs the repo-root
       .nuspec files through NuGet's NuspecFile feature; the SDK-style shim
       project that drives it is GENERATED into $(NObj)\Nuget per package, so
       nothing extra is checked in and no machine feed is touched (the shim has
       no PackageReferences; its restore is a local no-op under the repo
       nuget.config). Payload = current stage: ncc (.NET 10) tool closure
       under tools\net10.0, netstandard2.0 libraries under lib\netstandard2.0.
       Output $(NBin)\Nuget (Install keeps copying it). Not in any default
       target: invoked explicitly, like CompilerTests. -->
  <Target Name="_NugetPack">
    <PropertyGroup>
      <!-- Standalone invocation: package the newest built stage, where "newest"
           means the latest ncc.exe LastWriteTimeUtc among the existing
           $(NBin)\Stage{4..1} dirs, and NOT the highest-numbered dir (review2
           finding R2-03: a stale Stage3/Stage4 left over from an old run must
           not shadow a freshly rebuilt Stage1). Candidates are scanned
           highest-number-first via GetLastWriteTimeUtc().Ticks property
           functions and replace the incumbent only when strictly newer, so an
           exact tie still prefers the higher-numbered stage. In the
           DevBuild*/Installer* composites NCurBin is already set by the
           preceding stage target: NStageSelect stays unset, the guarded tick
           reads never run and every comparison below degenerates to "0 > 0"
           (no-op, as before this fix). -->
      <NStageSelect Condition=" '$(NCurBin)' == '' ">true</NStageSelect>
      <NStageBestTime>0</NStageBestTime>
      <NStageTime>0</NStageTime>
      <NStageTime Condition=" '$(NStageSelect)' == 'true' And Exists('$(NBin)\Stage4\ncc.exe') ">$([System.IO.File]::GetLastWriteTimeUtc('$(NBin)\Stage4\ncc.exe').Ticks)</NStageTime>
      <NCurBin Condition=" $(NStageTime) &gt; $(NStageBestTime) ">$(NBin)\Stage4</NCurBin>
      <NStageBestTime Condition=" $(NStageTime) &gt; $(NStageBestTime) ">$(NStageTime)</NStageBestTime>
      <NStageTime>0</NStageTime>
      <NStageTime Condition=" '$(NStageSelect)' == 'true' And Exists('$(NBin)\Stage3\ncc.exe') ">$([System.IO.File]::GetLastWriteTimeUtc('$(NBin)\Stage3\ncc.exe').Ticks)</NStageTime>
      <NCurBin Condition=" $(NStageTime) &gt; $(NStageBestTime) ">$(NBin)\Stage3</NCurBin>
      <NStageBestTime Condition=" $(NStageTime) &gt; $(NStageBestTime) ">$(NStageTime)</NStageBestTime>
      <NStageTime>0</NStageTime>
      <NStageTime Condition=" '$(NStageSelect)' == 'true' And Exists('$(NBin)\Stage2\ncc.exe') ">$([System.IO.File]::GetLastWriteTimeUtc('$(NBin)\Stage2\ncc.exe').Ticks)</NStageTime>
      <NCurBin Condition=" $(NStageTime) &gt; $(NStageBestTime) ">$(NBin)\Stage2</NCurBin>
      <NStageBestTime Condition=" $(NStageTime) &gt; $(NStageBestTime) ">$(NStageTime)</NStageBestTime>
      <NStageTime>0</NStageTime>
      <NStageTime Condition=" '$(NStageSelect)' == 'true' And Exists('$(NBin)\Stage1\ncc.exe') ">$([System.IO.File]::GetLastWriteTimeUtc('$(NBin)\Stage1\ncc.exe').Ticks)</NStageTime>
      <NCurBin Condition=" $(NStageTime) &gt; $(NStageBestTime) ">$(NBin)\Stage1</NCurBin>
      <NStageBestTime Condition=" $(NStageTime) &gt; $(NStageBestTime) ">$(NStageTime)</NStageBestTime>
    </PropertyGroup>
    <!-- Honesty in the pack log: which stage dir actually got packaged (also
         names the stage when NCurBin was passed explicitly). -->
    <Message Condition=" '$(NCurBin)' != '' " Importance="high" Text="_NugetPack: packaging stage '$(NCurBin)'" />
    <Error Condition=" '$(NCurBin)' == '' " Text="_NugetPack needs a built stage: no $(NBin)\Stage*\ncc.exe exists and NCurBin is not set. Build a stage first (e.g. ./build.ps1 -Targets Stage1,_NugetPack) or pass -p:NCurBin=&lt;stage dir&gt;. (net10 plan 6.5)" />
    <!-- Re-enter this project with NCurBin as a GLOBAL property so the
         _NugetPackCore dependencies (_PegAndCSharp/TestFramework) see
         Nemerle=$(NCurBin) even when _NugetPack was invoked standalone. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_NugetPackCore" Properties="NCurBin=$(NCurBin);Configuration=$(Configuration);NTargetName=$(NTargetName)" />
  </Target>

  <Target Name="_NugetPackCore" DependsOnTargets="_PegAndCSharp; TestFramework">
    <GetAssemblyIdentity AssemblyFiles="$(NCurBin)\Nemerle.dll">
      <Output TaskParameter="Assemblies" ItemName="NemerleRuntimeIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <NemerleProductVersion>$([System.Text.RegularExpressions.Regex]::Replace('%(NemerleRuntimeIdentity.Version)', '(?&lt;major&gt;\d+)\.(?&lt;minor&gt;\d+)\.0\.(?&lt;build&gt;\d+)', '${major}.${minor}.${build}.0'))</NemerleProductVersion>
      <NugetOutput>$(NBin)\Nuget</NugetOutput>
      <NugetPackDir>$(NObj)\Nuget</NugetPackDir>
    </PropertyGroup>
    <RemoveDir Directories="$(NugetOutput)" />
    <MakeDir Directories="$(NugetOutput);$(NugetPackDir)" />
    <!-- One generated shim per package. %3b is written as a literal ';'
         (MSBuild escape); a raw ';' in Lines would split the attribute into
         items and corrupt the generated csproj. NoWarn: NU5100 (payload files
         live outside the shim's project dir, by design) and NU5128 (nuspec-
         only packages have no ancillary build files). -->
    <WriteLinesToFile File="$(NugetPackDir)\Nemerle.Pack.csproj" Overwrite="true"
      Lines="&lt;Project Sdk='Microsoft.NET.Sdk'&gt;&lt;PropertyGroup&gt;&lt;TargetFramework&gt;net10.0&lt;/TargetFramework&gt;&lt;IncludeBuildOutput&gt;false&lt;/IncludeBuildOutput&gt;&lt;EnableDefaultCompileItems&gt;false&lt;/EnableDefaultCompileItems&gt;&lt;NuspecFile&gt;$(NRoot)\Nemerle.nuspec&lt;/NuspecFile&gt;&lt;NuspecProperties&gt;NCurBin=$(NCurBin)%3bNBin=$(NBin)%3bversion=$(NemerleProductVersion)&lt;/NuspecProperties&gt;&lt;NoWarn&gt;NU5100%3bNU5128&lt;/NoWarn&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" />
    <Exec Command="dotnet pack &quot;$(NugetPackDir)\Nemerle.Pack.csproj&quot; --nologo -o &quot;$(NugetOutput)&quot;" WorkingDirectory="$(NRoot)" />
    <WriteLinesToFile File="$(NugetPackDir)\Nemerle.Pack.csproj" Overwrite="true"
      Lines="&lt;Project Sdk='Microsoft.NET.Sdk'&gt;&lt;PropertyGroup&gt;&lt;TargetFramework&gt;net10.0&lt;/TargetFramework&gt;&lt;IncludeBuildOutput&gt;false&lt;/IncludeBuildOutput&gt;&lt;EnableDefaultCompileItems&gt;false&lt;/EnableDefaultCompileItems&gt;&lt;NuspecFile&gt;$(NRoot)\Nemerle.Compiler.nuspec&lt;/NuspecFile&gt;&lt;NuspecProperties&gt;NCurBin=$(NCurBin)%3bNBin=$(NBin)%3bversion=$(NemerleProductVersion)&lt;/NuspecProperties&gt;&lt;NoWarn&gt;NU5100%3bNU5128&lt;/NoWarn&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" />
    <Exec Command="dotnet pack &quot;$(NugetPackDir)\Nemerle.Pack.csproj&quot; --nologo -o &quot;$(NugetOutput)&quot;" WorkingDirectory="$(NRoot)" />
    <Message Importance="high" Text="NuGet packages v$(NemerleProductVersion) from $(NCurBin) -&gt; $(NugetOutput)" />
  </Target>

  <!-- Phase 5.5 stub: the IDE engine test suite lived in VsIntegration/, which
       this branch removed (master keeps it). The name stayed referenced by
       IntegrationFull/DevBuild*WithTests/DevBuildFull and aborted those
       invocations with a cryptic MSB4057 ("target does not exist") at
       scheduling time; fail with an actionable message instead. The Core graph
       never references this target. -->
  <Target Name="IdeEngineTests">
    <Error Text="IdeEngineTests does not exist on the retarget-compiler branch: the IDE engine tests lived in VsIntegration/ and were removed in the net10 retarget (master still ships them). Referenced only by IntegrationFull/DevBuildQuickWithTests/DevBuild2StageWithTests/DevBuildFull; revisit when the IDE layer is revived. (net10 plan 5.5)" />
  </Target>

  <Target Name="DevBuildQuickNccOnly"    DependsOnTargets="Stage1; Linq;Unsafe;_PegAndCSharp;                                                     Install" />
  <Target Name="DevBuildQuick"           DependsOnTargets="Stage1;                          _NugetPack; _Integration;                             Install" />
  <Target Name="DevBuildQuickWithTests"  DependsOnTargets="Stage1;           CompilerTests; _NugetPack; _Integration; IdeEngineTests;             Install" />
  <Target Name="DevBuild2Stage"          DependsOnTargets="Stage2;                          _NugetPack; _Integration;                             Install" />
  <Target Name="DevBuild2StageWithTests" DependsOnTargets="Stage2;           CompilerTests; _NugetPack; _Integration; IdeEngineTests;             Install" />
  <Target Name="DevBuildFull"            DependsOnTargets="Stage4; Validate; CompilerTests; _NugetPack; _Integration; IdeEngineTests; _PowerPack; Install" />

  <!--Helper target to build installer (WiX; Windows-only, isolated since 5.4;
      gated by _GuardVsIntegration since 5.5).-->
  <Target Name="_Installer" DependsOnTargets="_GuardVsIntegration" Condition="'$(UseMSBuild)' != ''">
    <PropertyGroup>
      <NCurBin Condition=" '$(NCurBin)' == '' ">$(NBin)\Stage1</NCurBin>
    </PropertyGroup>
    <MSBuild Projects="$(NRoot)\misc\packages\wix\nemerle.sln" Targets="$(NTargetName)" Properties="OutputPath=$(NBin)\Installer\; IntermediateOutputPath=$(NObj)\Installer\; Nemerle=$(NCurBin); Configuration=$(Configuration); NVer=$(NVer)" />
  </Target>
</Project>
