<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped NuGet feed configuration - Phase 5.3 of the net10 retarget.
  <clear/> makes builds of this repo independent of user/machine feeds
  (reproducible restores); the only packages the build graph consumes are
  the Microsoft.Build.* 17.0.0 references of Nemerle.MSBuild.Tasks.csproj,
  both served by nuget.org. Verified: isolated-cache restore with this file
  alone succeeds (see doc/plans/retarget-compiler-to-net10-plan/
  retarget-compiler-to-net10-plan-progress5.3.md).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
