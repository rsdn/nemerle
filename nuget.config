<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped NuGet feed configuration - Phase 5.3 of the net10 retarget.
  <clear/> makes builds of this repo independent of user/machine feeds
  (reproducible restores); the packages the build graph consumes are the
  Microsoft.Build.* 17.0.0 references of Nemerle.MSBuild.Tasks.csproj and
  the implicit NETStandard.Library 2.0.3 of the netstandard2.0 projects,
  all served by nuget.org. Verified: isolated-cache restore with this file
  alone succeeds (see doc/plans/retarget-compiler-to-net10-plan/
  retarget-compiler-to-net10-plan-progress5.3.md).

  FEED POLICY (reverts c31505973): this file is the public default and must
  stay on nuget.org. Mirrored environments (build servers without nuget.org
  access) inject their proxy feed PER INVOCATION, not as a commit here:
  the build definition passes
  /p:RestoreSources=https://repository.avp.ru/artifactory/api/nuget/v3/r-nuget
  to MSBuild. A command-line property overrides packageSources for the whole
  restore, so no per-repo feed commit is ever needed; manual local builds
  behind the mirror take the same flag.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
