<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>Nemerle.Compiler</id>
    <version>$version$</version>
    <title>Nemerle Compiler</title>
    <authors>Nemerle Team</authors>
    <description>Nemerle compiler with C# support: the ncc-core (.NET 10) toolchain and the compiler assemblies.</description>
    <projectUrl>http://nemerle.org/</projectUrl>
    <licenseUrl>http://opensource.org/licenses/BSD-3-Clause</licenseUrl>
    <dependencies>
      <dependency id="Nemerle" version="$version$" />
    </dependencies> 
  </metadata>
  <files>
    <!-- 6.5: net10 payload. The tool closure (ncc-core.exe + the assemblies and
         host config it needs to run; same set as the boot-net10 seed) goes under
         tools\net10.0 so NuGet never treats the .NET 10 binaries as compile
         references. The old `ncc.???`/`ncc??.???` lines were commented-out ghosts
         since 3.4b (ncc.exe left the build graph). Libraries keep the old lib\
         intent under the correct netstandard2.0 moniker (D2/D6: libs stay ns2.0).
         Nemerle.MSBuild.Tasks.dll / .targets / Sdk props are NOT packaged: the
         old package never shipped them (IDE/installer layer). -->
    <file src="$NCurBin$\ncc-core.exe"                target="tools\net10.0\" />
    <file src="$NCurBin$\ncc-core.dll"                target="tools\net10.0\" />
    <file src="$NCurBin$\ncc-core.runtimeconfig.json" target="tools\net10.0\" />
    <file src="$NCurBin$\ncc-core.deps.json"          target="tools\net10.0\" />
    <file src="$NCurBin$\dnlib.dll"                   target="tools\net10.0\" />
    <file src="$NCurBin$\System.CodeDom.dll"          target="tools\net10.0\" />
    <file src="$NCurBin$\Nemerle.dll"                 target="tools\net10.0\" />
    <file src="$NCurBin$\Nemerle.Compiler.dll"        target="tools\net10.0\" />
    <file src="$NCurBin$\Nemerle.Macros.dll"          target="tools\net10.0\" />
    <file src="$NCurBin$\Nemerle.Compiler.dll"        target="lib\netstandard2.0\" />
    <file src="$NCurBin$\Nemerle.Macros.dll"          target="lib\netstandard2.0\" />
  </files>
</package>