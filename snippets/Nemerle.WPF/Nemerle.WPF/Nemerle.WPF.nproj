<?xml version="1.0" encoding="utf-8"?>
<!-- Test-suite fixture for testsuite\{positive,negative}\notifypropertychanged.n
     (both declare `MACRO: Nemerle.WPF.dll`; the harness passes it as -m:, see
     NccTestDescription.n / NccTest.n; built by the _Wpf target in
     NemerleAll.nproj). Migrated to the netstandard2.0 Sdk shape of
     Linq\Macro\Linq.nproj under the net10 retarget: NoStdLib +
     Nemerle/Nemerle.Compiler referenced from the current stage drop; needs no
     .NET Framework targeting pack on the build machine (the v4.6.1 TFM was
     MSB3644 on VS 18 BuildTools agents).

     DependencyProperty.n is NOT compiled: its syntax quotes are statically
     typed against `using System.Windows`, so it alone would pin the build to
     FX 4.x/WindowsDesktop reference assemblies. Nothing in the test suite
     exercises that macro (only the NotifyPropertyChanged family is used) and
     the FX-era sample under ..\Test is not built anywhere. The source file
     stays in the tree; the shipping WPF macro set remains on `master`. -->
<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoStdLib>true</NoStdLib>
    <NemerleVersion>Net-4.0</NemerleVersion>
    <NemerleBinPathRoot Condition=" '$(NemerleBinPathRoot)' == '' ">$(ProgramFiles)\Nemerle</NemerleBinPathRoot>
    <Nemerle Condition=" '$(Nemerle)' == '' ">$(NemerleBinPathRoot)\$(NemerleVersion)</Nemerle>
    <Name>Nemerle.WPF</Name>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{1f6ca7da-f1ef-4b4e-80e2-272c41761b3f}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Nemerle.WPF</RootNamespace>
    <AssemblyName>Nemerle.WPF</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.props" />
  <ItemGroup>
    <Reference Include="$(Nemerle)\Nemerle.dll" />
    <Reference Include="$(Nemerle)\Nemerle.Compiler.dll" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="NotifyPropertyChanged.n" />
    <Compile Include="Properties\AssemblyInfo.n" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.targets" />
</Project>
