<Project InitialTargets="GuardNemerleCompilerSeed">
  <PropertyGroup>
    <Nemerle Condition=" '$(Nemerle)' == '' ">$(MSBuildProjectDirectory)\boot</Nemerle>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid Condition=" '$(ProjectGuid)' == '' ">{0c558e38-7df9-4a68-9015-b316dd59c0cb}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <AssemblyName Condition="'$(AssemblyName)' == ''">ncc</AssemblyName>
    <WarningLevel>4</WarningLevel>
    <NoStdLib>true</NoStdLib>
    <!--NoStdMacros>true</NoStdMacros-->
    <GreedyReferences>false</GreedyReferences>
    <KeyOriginatorFile Condition="'$(NKeysDir)' == ''">misc\keys\Nemerle.Compiler.snk</KeyOriginatorFile>
    <KeyOriginatorFile Condition="'$(NKeysDir)' != ''">$(NKeysDir)\Nemerle.Compiler.snk</KeyOriginatorFile>
    <TargetFramework>net10.0</TargetFramework>
    <!--Implicitly true for .NET>=5 (Microsoft.NET.TargetFrameworkInference.targets); ncc's CoreCompile emits no refint assembly.-->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.props" Condition="Exists('$(Nemerle)\Nemerle.Sdk.props')" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>$(OutputPath)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="ncc" />
    <Compile Include="ncc\shared\AssemblyInfo.n">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="ncc\main.n">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!--Keep dnlib's package flow (so ncc.deps.json lists it for the Core host), but overwrite the
        copied lib/net6.0 file (its System.Runtime 6.0.0.0 reference cannot bind in the .NET Framework
        ncc.exe that used to share the stage output dir, 0x80131040) with the identical-identity
        lib/netstandard2.0 build, which binds on both runtimes and is what the netcoreapp2.1 restore
        used to pick.-->
    <PackageReference Include="dnlib" Version="4.5.0" GeneratePathProperty="true" />
    <!--System.CodeDom flows here transitively via Nemerle.Compiler; declared only to get the
        $(PkgSystem_CodeDom) path property (Pkg* is generated only for declared references).
        Same 4.7.0 already pinned there, so the restore graph is unchanged. The net10 restore
        resolves it to the lib/netstandard2.0 full implementation (181,832 B), which this host's
        CopyLocal would then drop into the shared flat stage dir over the identical-identity
        (4.0.3.0) lib/net461 facade (25,192 B) that the net461 ncc.exe used to copy; ncc itself
        never executes CodeDom code, so the overwrite target below pins the facade.-->
    <!--Version 4.7.0 must stay in sync with Nemerle.Compiler.nproj: the AfterTargets overwrite
        below copies $(PkgSystem_CodeDom)\lib\net461\System.CodeDom.dll, and that path vanishes
        in 7.0.0+ (lib/net461 dropped). Keep-in-sync decision: report3.3a-codedom.md.-->
    <PackageReference Include="System.CodeDom" Version="4.7.0" GeneratePathProperty="true" />
  </ItemGroup>
  <Target Name="OverrideDnlibAssetWithNetStandard" AfterTargets="Build">
    <Copy SourceFiles="$(Pkgdnlib)\lib\netstandard2.0\dnlib.dll"
          DestinationFiles="$(OutDir)dnlib.dll"
          SkipUnchangedFiles="true" />
    <!--Same flat-dir rationale as the dnlib block: ncc is the last project of the stage,
        so overwrite System.CodeDom.dll back to the lib/net461 facade (25,192 B, identity
        4.0.3.0, same file the old ncc.exe copies and what codedom.n executes); ncc never
        executes CodeDom code (no refs in main.n, the providers live in Nemerle.Compiler.dll).-->
    <Copy SourceFiles="$(PkgSystem_CodeDom)\lib\net461\System.CodeDom.dll"
          DestinationFiles="$(OutDir)System.CodeDom.dll"
          SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="Nemerle.Compiler.nproj">
      <Name>Nemerle.Compiler</Name>
      <Project>{0c558e36-7df9-4a68-9015-b316dd59c0cb}</Project>
      <Private>True</Private>
    </ProjectReference>
    <ProjectReference Include="Nemerle.nproj">
      <Name>Nemerle</Name>
      <Project>{0c558e35-7df9-4a68-9015-b316dd59c0cb}</Project>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.targets" Condition="Exists('$(Nemerle)\Nemerle.Sdk.props')" />
  <!--Standalone-build guard (net10 plan 8.3a): the boot/ seed is binary-only (retarget-era dir name was renamed in 10.2); Nemerle.Sdk.props/.targets live in compiler drops (NBoot/stages/Install). When the seed is pointed at directly, the imports above are skipped and this guard fails with the resolved path and an actionable message instead of a raw MSB4019 or a silent stale bin\boot seed (the removed R1-02 fallback).-->
  <Target Name="GuardNemerleCompilerSeed" Condition="!Exists('$(Nemerle)\Nemerle.Sdk.props')">
    <Error Text="Nemerle compiler not found at '$(Nemerle)' (no Nemerle.Sdk.props there). Build through NemerleAll.nproj (build.ps1 passes Nemerle= itself), or pass /p:Nemerle=&lt;dir with Nemerle.Sdk.props&gt;, e.g. bin\$(Configuration)\net-4.0. (net10 plan 8.3a)" />
  </Target>
</Project>