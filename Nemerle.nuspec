<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>Nemerle</id>
    <version>$version$</version>
    <title>Nemerle Runtime</title>
    <authors>Nemerle Team</authors>
    <description>Nemerle runtime with utility libraries.</description>
    <projectUrl>http://nemerle.org/</projectUrl>
    <licenseUrl>http://opensource.org/licenses/BSD-3-Clause</licenseUrl>
  </metadata>
  <files>
    <!-- 6.5: all three assemblies target netstandard2.0 (D2/D6); the old
         `lib\net\` moniker matched nothing under modern NuGet TFM rules.
         Explicit .dll names instead of `.???` globs: no .pdb/.xml ghosts. -->
    <file src="$NCurBin$\Nemerle.dll"                 target="lib\netstandard2.0\" />
    <file src="$NBin$\PowerPack\Nemerle.Peg.dll"      target="lib\netstandard2.0\" />
    <file src="$NBin$\TestFramework\Nemerle.Diff.dll" target="lib\netstandard2.0\" />
  </files>
</package>