<?xml version="1.0" encoding="utf-8"?>
<!--
  Directory.Build.props - Phase 5.3 of the net10 retarget
  (doc/plans/retarget-compiler-to-net10-plan/retarget-compiler-to-net10-plan-progress5.3.md).

  BLAST RADIUS: this file is evaluated by EVERY project under the repo root
  that imports Microsoft.Common.props - which here is not only the one
  SDK-style project (Nemerle.MSBuild.Tasks.csproj) but ALSO every .nproj:
  they import $(Nemerle)\Nemerle.Sdk.props, which ends with
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />. Only the
  orchestrator itself (NemerleAll.nproj) imports nothing and skips this file.
  Therefore every property below must be ZERO-DELTA: identical to what the
  projects already resolve today, or it silently reconfigures the bootstrap
  chain. NemerleAll.nproj remains the build orchestrator; the .nproj-specific
  host settings live in tools/msbuild-task/Nemerle.Sdk.props (untouched).

  Properties deliberately NOT set here (probed 2026-10-31, see progress doc):
    TargetFramework        - differs per project (netstandard2.0 libs,
                             net10.0 ncc, harness targets); a global
                             value would corrupt the stage chain.
    LangVersion            - Nemerle.MSBuild.Tasks.csproj resolves 7.3 as the
                             netstandard2.0 TFM default; .nproj resolve empty
                             (ncc has no such switch). A global literal would
                             either change the .nproj resolved value or
                             shadow the per-TFM default.
    Nullable               - empty everywhere; the SDK passes
                             Nullable="$(Nullable)" to Csc and empty means
                             disabled, i.e. already the effective state.
-->
<Project>
  <PropertyGroup>
    <!-- Identity: MSBuild/SDK default is false, every project probed resolves
         false today. Kept false on purpose: the compiler regression suite and
         the .nproj chain have pre-existing warnings; flipping this to true is
         a candidate cleanup after Phase 6, not before. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
