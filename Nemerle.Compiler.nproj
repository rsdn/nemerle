<Project InitialTargets="GuardNemerleCompilerSeed">
  <PropertyGroup>
    <Nemerle Condition=" '$(Nemerle)' == '' ">$(MSBuildProjectDirectory)\boot-net10</Nemerle>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{0c558e36-7df9-4a68-9015-b316dd59c0cb}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AssemblyName>Nemerle.Compiler</AssemblyName>
    <WarningLevel>4</WarningLevel>
    <NoStdLib>true</NoStdLib>
    <EnabledWarnings>10006</EnabledWarnings>
    <!--NoStdMacros>true</NoStdMacros-->
    <GreedyReferences>false</GreedyReferences>
    <KeyOriginatorFile Condition="'$(NKeysDir)' == ''">misc\keys\Nemerle.Compiler.snk</KeyOriginatorFile>
    <KeyOriginatorFile Condition="'$(NKeysDir)' != ''">$(NKeysDir)\Nemerle.Compiler.snk</KeyOriginatorFile>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.props" Condition="Exists('$(Nemerle)\Nemerle.Sdk.props')" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <!-- <DocumentationFile>$(OutputPath)\Nemerle.Compiler.xml</DocumentationFile> -->
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)\Nemerle.Compiler.xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
    <!--Pinned 4.7.0: 7.0.0+ dropped lib/net461, so net461 consumers would load the package's
        full-impl asset, which splits CodeDom type identities from the in-box ones (breaks
        codedom.n). The net461 stage must carry the forwarding facade; bump only together with
        removing ncc/frontend/codedom. Rationale + evidence: doc/plans/retarget-compiler-to-net10-plan/
        retarget-compiler-to-net10-plan-report3.3a-codedom.md-->
    <PackageReference Include="System.CodeDom" Version="4.7.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Nemerle.nproj">
      <Name>Nemerle</Name>
      <Project>{0c558e35-7df9-4a68-9015-b316dd59c0cb}</Project>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ncc\shared\**\*.n">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="ncc\backend\**\*.n">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="ncc\frontend\**\*.n">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Nemerle.Location\**\*.n" Exclude="Nemerle.Location\bin\**\_N_*.n;Nemerle.Location\Properties\AssemblyInfo.n">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.targets" Condition="Exists('$(Nemerle)\Nemerle.Sdk.props')" />
  <!--Standalone-build guard (net10 plan 8.3a): the boot-net10 seed is binary-only; Nemerle.Sdk.props/.targets live in compiler drops (NBoot/stages/Install). When the seed is pointed at directly, the imports above are skipped and this guard fails with the resolved path and an actionable message instead of a raw MSB4019 or a silent stale bin\boot seed (the removed R1-02 fallback).-->
  <Target Name="GuardNemerleCompilerSeed" Condition="!Exists('$(Nemerle)\Nemerle.Sdk.props')">
    <Error Text="Nemerle compiler not found at '$(Nemerle)' (no Nemerle.Sdk.props there). Build through NemerleAll.nproj (build.ps1 passes Nemerle= itself), or pass /p:Nemerle=&lt;dir with Nemerle.Sdk.props&gt;, e.g. bin\$(Configuration)\net-4.0. (net10 plan 8.3a)" />
  </Target>
</Project>