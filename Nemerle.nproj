<Project InitialTargets="GuardNemerleCompilerSeed">
  <PropertyGroup>
    <Nemerle Condition=" '$(Nemerle)' == '' ">$(MSBuildProjectDirectory)\boot</Nemerle>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{0c558e35-7df9-4a68-9015-b316dd59c0cb}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AssemblyName>Nemerle</AssemblyName>
    <Name>Nemerle</Name>
    <WarningLevel>4</WarningLevel>
    <NoStdLib>true</NoStdLib>
    <EnabledWarnings>10006</EnabledWarnings>
    <!--NoStdMacros>true</NoStdMacros-->
    <GreedyReferences>false</GreedyReferences>
    <KeyOriginatorFile Condition="'$(NKeysDir)' == ''">misc\keys\Nemerle.snk</KeyOriginatorFile>
    <KeyOriginatorFile Condition="'$(NKeysDir)' != ''">$(NKeysDir)\Nemerle.snk</KeyOriginatorFile>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.props" Condition="Exists('$(Nemerle)\Nemerle.Sdk.props')" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <!-- <DocumentationFile>$(OutputPath)\Nemerle.xml</DocumentationFile> -->
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <DocumentationFile>$(OutputPath)\Nemerle.xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="lib" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="lib\*.n" />
  </ItemGroup>
  <Import Project="$(Nemerle)\Nemerle.Sdk.targets" Condition="Exists('$(Nemerle)\Nemerle.Sdk.props')" />
  <!--Standalone-build guard (net10 plan 8.3a): the boot/ seed is binary-only (retarget-era dir name was renamed in 10.2); Nemerle.Sdk.props/.targets live in compiler drops (NBoot/stages/Install). When the seed is pointed at directly, the imports above are skipped and this guard fails with the resolved path and an actionable message instead of a raw MSB4019 or a silent stale bin\boot seed (the removed R1-02 fallback).-->
  <Target Name="GuardNemerleCompilerSeed" Condition="!Exists('$(Nemerle)\Nemerle.Sdk.props')">
    <Error Text="Nemerle compiler not found at '$(Nemerle)' (no Nemerle.Sdk.props there). Build through NemerleAll.nproj (build.ps1 passes Nemerle= itself), or pass /p:Nemerle=&lt;dir with Nemerle.Sdk.props&gt;, e.g. bin\$(Configuration)\net-4.0. (net10 plan 8.3a)" />
  </Target>
</Project>