<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- One netstandard2.0 assembly that loads in BOTH the classic MSBuild.exe
       (.NET Framework) host and the .NET `dotnet msbuild` host.
       Targeting net10.0 here is not an option: the Framework host cannot load it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Nemerle.MSBuild.Tasks</RootNamespace>
    <AssemblyName>Nemerle.MSBuild.Tasks</AssemblyName>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Honor the OutputPath / IntermediateOutputPath passed verbatim from
         NemerleAll.nproj (NTasks target) without TFM subfolders. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendTargetFrameworkToIntermediateOutputPath>false</AppendTargetFrameworkToIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-time only, host-provided at runtime; nothing is copied to output. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="tools\msbuild-task\GetGitTagRevision.cs" />
    <Compile Include="tools\msbuild-task\Properties\AssemblyInfo.cs" />
    <Compile Include="tools\msbuild-task\SetEnvironmentVariable.cs" />
    <Compile Include="tools\msbuild-task\MSBuildTask.cs" />
  </ItemGroup>
  <!-- Classic MSBuild.exe has no implicit NuGet restore; restore once when the
       assets file is absent (e.g. when driven by NemerleAll.nproj NTasks). -->
  <Target Name="EnsurePackagesRestored" BeforeTargets="Build;Rebuild" Condition="!Exists('$(MSBuildProjectExtensionsPath)$(MSBuildProjectFile).nuget.g.props')">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore" />
  </Target>
  <!-- NOTE: must NOT be named `AfterBuild`: the empty `AfterBuild` target from
       Microsoft.Common.CurrentVersion.targets (imported after this file in SDK
       projects) would override it. -->
  <Target Name="CopyNemerleTargetsToOutput" AfterTargets="Build">
    <Copy DestinationFolder="$(OutputPath)" SourceFiles="
      $(ProjectDir)tools\msbuild-task\Nemerle.MSBuild.targets;
      $(ProjectDir)tools\msbuild-task\Nemerle.Sdk.targets;
      $(ProjectDir)tools\msbuild-task\Nemerle.Sdk.props" />
  </Target>
</Project>
